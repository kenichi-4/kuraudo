<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>CPU対戦チンチロ</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <main class="card">
    <h1>CPU対戦チンチロ</h1>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <section>

      <form action="/start" method="post">
        <input type="text" name="name" placeholder="名前を入力">
        <div class="difficulty">
          <p>CPUの強さ</p>
          <label>
            <input type="radio" name="difficulty" value="strong">
            強い
          </label>
          <label>
            <input type="radio" name="difficulty" value="normal" checked>
            普通
          </label>
          <label>
            <input type="radio" name="difficulty" value="weak">
            弱い
          </label>
        </div>
        <input type="submit" value="CPUと対戦する">
      </form>
    </section>

  </main>
</body>
</html>
