<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>CPU対戦チンチロ</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <main class="card">
    <h1>CPU対戦チンチロ</h1>

    <p class="message"><%= game.message %></p>
    <p>あなた：<strong><%= me.name %></strong></p>

    <form class="rollForm" data-target="player" action="/game/<%= game.id %>/roll" method="post">
      <% if (me.result && (me.result.hasRole || me.rollCount >= maxRolls)) { %>
        <input type="submit" value="このラウンドは確定済み" disabled>
      <% } else { %>
        <input type="submit" value="サイコロを振る（<%= me.rollCount %>/<%= maxRolls %>回）">
      <% } %>
    </form>

    <% if (game.status === 'cpu') { %>
      <form class="rollForm" data-target="cpu" action="/game/<%= game.id %>/cpu-roll" method="post">
        <input type="submit" value="CPUのサイコロを振る">
      </form>
    <% } %>

    <form action="/game/<%= game.id %>/reset" method="post">
      <input type="submit" value="もう一回">
    </form>

    <div class="players">
      <% for (const player of game.players) { %>
        <div class="playerCard" data-player="<%= player.id %>">
          <h3><%= player.name %><%= player.isCpu ? '' : '（自分）' %></h3>
          <div class="dice"><%= player.dice ? player.dice.join(' ') : '- - -' %></div>
          <div class="result"><%= player.result ? player.result.name : '結果待ち' %></div>
          <div class="status">振った回数：<%= player.rollCount %>/<%= maxRolls %>回</div>
          <% if (player.result && (player.result.hasRole || player.rollCount >= maxRolls)) { %>
            <div class="status">確定</div>
          <% } else { %>
            <div class="status">未確定</div>
          <% } %>
        </div>
      <% } %>
    </div>

    <% if (game.status === 'finished') { %>
      <section class="ranking">
        <h2>結果</h2>
        <ol>
          <% for (const player of ranking) { %>
            <li><%= player.place %>位：<%= player.name %>　<%= player.dice.join(' ') %>　<%= player.result.name %>（<%= player.rollCount %>回）</li>
          <% } %>
        </ol>
      </section>
    <% } %>

    <form action="/game/<%= game.id %>/end" method="post">
      <button type="submit">トップへ戻る</button>
    </form>
  </main>
  <script src="/public/client.js"></script>
</body>
</html>
